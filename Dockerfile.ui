FROM node:24-alpine AS frontend
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci --ignore-scripts
COPY web/ ./
RUN npm test && npm run build

FROM python:3.12-slim
RUN pip install --no-cache-dir 'httpx[http2]==0.28.1' 'PyMuPDF==1.28.2'
WORKDIR /app
ENV DATA_DIR=/data
COPY *.py ./
COPY config/ ./config/
COPY --from=frontend /web/dist ./web/dist
RUN useradd --uid 10001 --create-home collector && mkdir /data && chown collector:collector /data
USER collector
EXPOSE 8787
VOLUME ["/data"]
ENTRYPOINT ["python3", "-u", "/app/dashboard_server.py"]
CMD ["--host", "0.0.0.0", "--port", "8787", "--data-dir", "/data", "--native-dir", "/native-data", "--reports-dir", "/reports"]
